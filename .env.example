# Optional: "OpenAI API" or "Ollama (local)".
# Defaults to OpenAI when OPENAI_API_KEY is set; otherwise defaults to Ollama.
# AI_PROVIDER=OpenAI API

OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# Copy this file to .env before adding your key. Never put a real key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
